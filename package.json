{
  "name": "darkest-terminal",
  "version": "0.1.2",
  "description": "Terminal roguelike dungeon crawler — turn-based combat, procedurally generated floors, permadeath. Runs on Bun + OpenTUI, playable via npx.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Nguyen Doan Quoc Nhat",
  "homepage": "https://github.com/Nhat-TheDev/DarkestTerminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nhat-TheDev/DarkestTerminal.git"
  },
  "bugs": {
    "url": "https://github.com/Nhat-TheDev/DarkestTerminal/issues"
  },
  "keywords": [
    "game",
    "terminal-game",
    "terminal",
    "cli-game",
    "cli",
    "tui",
    "opentui",
    "roguelike",
    "rogue",
    "dungeon-crawler",
    "dungeon",
    "rpg",
    "turn-based",
    "ascii",
    "bun"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "darkest-terminal": "bin/darkest-terminal.js"
  },
  "files": ["bin", "README.md", "LICENSE"],
  "scripts": {
    "start": "bun run src/main.ts",
    "build": "bun build ./src/main.ts --compile --outfile dist/darkest-terminal",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "sprite-editor": "bun run tools/sprite-editor/server.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3"
  },
  "optionalDependencies": {
    "darkest-terminal-darwin-arm64": "0.1.2",
    "darkest-terminal-darwin-x64": "0.1.2",
    "darkest-terminal-win32-x64": "0.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
