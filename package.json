{
  "name": "darkest-terminal",
  "version": "0.1.1",
  "description": "Prototype: 1-floor playable slice of the terminal dungeon crawler design.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Nguyen Doan Quoc Nhat",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@quocnhatthedev/Nhat-TheDev/DarkestTerminal.git"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "darkest-terminal": "bin/darkest-terminal.js"
  },
  "files": ["bin", "README.md", "LICENSE"],
  "scripts": {
    "start": "bun run src/main.ts",
    "build": "bun build ./src/main.ts --compile --outfile \"${OUTFILE:-dist/darkest-terminal}\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "sprite-editor": "bun run tools/sprite-editor/server.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3"
  },
  "optionalDependencies": {
    "darkest-terminal-darwin-arm64": "0.1.1",
    "darkest-terminal-darwin-x64": "0.1.1",
    "darkest-terminal-win32-x64": "0.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
